{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partitureperme",
  "main": "cf/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partitureperme"
    }
  ],
  "observability": { "enabled": true }
}
